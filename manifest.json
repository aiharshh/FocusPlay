{
  "manifest_version": 3,
  "name": "FocusPlay",
  "version": "1.0.0",
  "description": "Your space to focus.",
  "permissions": [
    "activeTab",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open in FocusPlay"
  }
}